<script>
document.getElementById('year').textContent = new Date().getFullYear();

/* Figure 1: three drifting, loosely-connected clusters (AI / Data / Security) */
(function(){
  const canvas = document.getElementById('clusterChart');
  const ctx = canvas.getContext('2d');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let w,h,dpr;
  let clusters = [];
  let t = 0;

  const colors = ['#3350c8','#1f8f74','#b23a3a'];

  function resize(){
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    const rect = canvas.getBoundingClientRect();
    w = canvas.width = rect.width * dpr;
    h = canvas.height = 220 * dpr;
    canvas.style.height = '220px';

    const centers = [
      {x:w*0.28, y:h*0.55},
      {x:w*0.72, y:h*0.32},
      {x:w*0.58, y:h*0.78}
    ];
    clusters = centers.map((c,ci)=>{
      const pts = [];
      const n = 16;
      for(let i=0;i<n;i++){
        pts.push({
          ang: Math.random()*Math.PI*2,
          rad: Math.random()*46*dpr + 6*dpr,
          speed: 0.15 + Math.random()*0.25,
          phase: Math.random()*Math.PI*2,
          size: (Math.random()*1.6+1)*dpr
        });
      }
      return {cx:c.x, cy:c.y, pts, color:colors[ci]};
    });
  }

  function draw(){
    ctx.clearRect(0,0,w,h);

    // faint lines between cluster centers
    ctx.strokeStyle = 'rgba(28,28,26,0.10)';
    ctx.lineWidth = 1;
    for(let i=0;i<clusters.length;i++){
      for(let j=i+1;j<clusters.length;j++){
        ctx.beginPath();
        ctx.moveTo(clusters[i].cx, clusters[i].cy);
        ctx.lineTo(clusters[j].cx, clusters[j].cy);
        ctx.stroke();
      }
    }

    clusters.forEach(cl=>{
      cl.pts.forEach(p=>{
        const wob = Math.sin(t*p.speed + p.phase) * 6 * dpr;
        const x = cl.cx + Math.cos(p.ang) * (p.rad + wob);
        const y = cl.cy + Math.sin(p.ang) * (p.rad + wob) * 0.72;
        ctx.fillStyle = cl.color;
        ctx.globalAlpha = 0.68;
        ctx.beginPath();
        ctx.arc(x,y,p.size,0,Math.PI*2);
        ctx.fill();
        ctx.globalAlpha = 1;
      });
      // centroid marker
      ctx.fillStyle = cl.color;
      ctx.globalAlpha = 0.9;
      ctx.beginPath();
      ctx.arc(cl.cx, cl.cy, 3*dpr, 0, Math.PI*2);
      ctx.fill();
      ctx.globalAlpha = 1;
    });
  }

  function step(){
    draw();
    t += 0.02;
    if(!reduceMotion) requestAnimationFrame(step);
  }

  resize();
  step();
  window.addEventListener('resize', resize);
})();

/* smooth active-nav highlight (subtle, optional) */
const navlinks = document.querySelectorAll('.metabar nav a');
const secs = Array.from(navlinks).map(l=>document.querySelector(l.getAttribute('href')));
function onScroll(){
  let idx = -1;
  const y = window.scrollY + 120;
  secs.forEach((s,i)=>{ if(s && s.offsetTop <= y) idx = i; });
  navlinks.forEach((l,i)=> l.style.color = i===idx ? 'var(--ink)' : '');
}
window.addEventListener('scroll', onScroll, {passive:true});
onScroll();
</script>

