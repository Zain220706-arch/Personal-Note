<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mikel Muhammad Zain</title>
<style>
  :root{
    --paper:#f7f6f1;
    --paper-2:#efede4;
    --ink:#1c1c1a;
    --ink-soft:#54524a;
    --ink-dim:#8f8c80;
    --rule:#d9d5c8;
    --blue:#3350c8;   /* AI */
    --teal:#1f8f74;   /* Data */
    --crimson:#b23a3a;/* Cybersecurity */
    --serif:'Source Serif 4','Iowan Old Style','Georgia',serif;
    --mono:'IBM Plex Mono','JetBrains Mono','Courier New',monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:var(--serif);
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;}
  ::selection{background:rgba(51,80,200,0.18);}

  .page{
    max-width:760px;
    margin:0 auto;
    padding:0 28px 100px;
  }

  /* ---------------- top meta bar ---------------- */
  .metabar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:22px 0;
    font-family:var(--mono);
    font-size:11.5px;
    color:var(--ink-dim);
    letter-spacing:0.01em;
    border-bottom:1px solid var(--rule);
  }
  .metabar nav{display:flex;gap:20px;}
  .metabar nav a{color:var(--ink-dim);transition:color .15s ease;}
  .metabar nav a:hover{color:var(--ink);}

  /* ---------------- header / title block ---------------- */
  header.titleblock{
    padding:64px 0 40px;
    border-bottom:1px solid var(--rule);
  }
  .idchip{
    width:52px;height:52px;
    border:1.5px solid var(--ink);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);
    font-weight:600;
    font-size:19px;
    margin-bottom:28px;
    position:relative;
  }
  .idchip::after{
    content:"";
    position:absolute;
    left:-1.5px;right:-1.5px;bottom:-6px;
    height:3px;
    background:linear-gradient(90deg,var(--blue),var(--teal),var(--crimson));
  }
  h1.title{
    font-size:clamp(32px,5.4vw,50px);
    font-weight:600;
    line-height:1.12;
    letter-spacing:-0.01em;
  }
  .subtitle{
    margin-top:12px;
    font-size:19px;
    font-style:italic;
    color:var(--ink-soft);
  }
  .abstract{
    margin-top:30px;
    font-size:16px;
    line-height:1.8;
    color:var(--ink-soft);
    max-width:66ch;
  }
  .abstract .lbl{
    font-family:var(--mono);
    font-size:11px;
    color:var(--ink-dim);
    display:block;
    margin-bottom:8px;
  }
  .keywords{
    margin-top:22px;
    font-family:var(--mono);
    font-size:12px;
    color:var(--ink-dim);
  }
  .keywords span.kw{
    color:var(--ink-soft);
  }

  /* ---------------- figure ---------------- */
  .figure{
    margin:50px 0;
    border:1px solid var(--rule);
    background:var(--paper-2);
    padding:20px 20px 16px;
  }
  .figure canvas{
    width:100%;
    height:220px;
    display:block;
  }
  .figure figcaption{
    margin-top:14px;
    font-family:var(--mono);
    font-size:11.5px;
    color:var(--ink-dim);
    line-height:1.6;
  }
  .figure figcaption b{color:var(--ink-soft);font-weight:600;}
  .legend{
    display:flex;gap:18px;margin-top:10px;
    font-family:var(--mono);font-size:11px;color:var(--ink-soft);
  }
  .legend span{display:flex;align-items:center;gap:6px;}
  .swatch{width:9px;height:9px;border-radius:50%;display:inline-block;}

  /* ---------------- sections ---------------- */
  section{
    padding:52px 0;
    border-bottom:1px solid var(--rule);
  }
  section:last-of-type{border-bottom:none;}
  .sec-title{
    display:flex;
    align-items:baseline;
    gap:12px;
    margin-bottom:26px;
  }
  .sec-title .num{
    font-family:var(--mono);
    font-size:14px;
    color:var(--ink-dim);
  }
  .sec-title h2{
    font-size:23px;
    font-weight:600;
    letter-spacing:-0.005em;
  }
  .prose{
    font-size:16px;
    line-height:1.85;
    color:var(--ink-soft);
    max-width:66ch;
  }
  .prose p + p{margin-top:16px;}

  /* ---------------- focus areas ---------------- */
  .areas{
    display:flex;
    flex-direction:column;
    gap:22px;
  }
  .area{
    display:grid;
    grid-template-columns:22px 1fr;
    gap:16px;
  }
  .area .dot{
    width:11px;height:11px;
    border-radius:50%;
    margin-top:7px;
  }
  .area h3{
    font-size:16.5px;
    font-weight:600;
    margin-bottom:5px;
  }
  .area p{
    font-size:14.5px;
    line-height:1.75;
    color:var(--ink-soft);
    max-width:60ch;
  }

  /* ---------------- works as citations ---------------- */
  .works{
    display:flex;
    flex-direction:column;
    gap:24px;
  }
  .work{
    display:grid;
    grid-template-columns:38px 1fr;
    gap:16px;
  }
  .work .tag{
    font-family:var(--mono);
    font-size:13px;
    color:var(--ink-dim);
    padding-top:2px;
  }
  .work h3{
    font-size:16.5px;
    font-weight:600;
    margin-bottom:6px;
  }
  .work h3 .field{
    font-family:var(--mono);
    font-size:10.5px;
    font-weight:400;
    color:#fff;
    padding:2px 7px;
    border-radius:2px;
    margin-right:9px;
    position:relative;
    top:-2px;
  }
  .work p{
    font-size:14.5px;
    line-height:1.75;
    color:var(--ink-soft);
    max-width:62ch;
  }

  /* ---------------- references / contact ---------------- */
  .refs{
    display:flex;
    flex-direction:column;
    gap:14px;
    font-size:14.5px;
  }
  .ref{
    display:grid;
    grid-template-columns:44px 1fr;
    gap:14px;
    padding:14px 0;
    border-bottom:1px dashed var(--rule);
  }
  .ref:last-child{border-bottom:none;}
  .ref .tag{font-family:var(--mono);color:var(--ink-dim);font-size:13px;}
  .ref .rmeta{color:var(--ink-soft);}
  .ref .rmeta b{color:var(--ink);font-weight:600;}
  .ref a{
    font-family:var(--mono);
    font-size:13px;
    color:var(--blue);
    border-bottom:1px solid rgba(51,80,200,0.3);
  }
  .ref a:hover{border-bottom-color:var(--blue);}

  footer{
    padding:40px 0 0;
    font-family:var(--mono);
    font-size:11px;
    color:var(--ink-dim);
    display:flex;
    justify-content:space-between;
  }

  @media (max-width:560px){
    .page{padding:0 20px 70px;}
    header.titleblock{padding:48px 0 32px;}
    .metabar nav{gap:12px;}
    .work, .area{grid-template-columns:1fr;gap:6px;}
  }
</style>
